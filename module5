#!/bin/sh
# Module 5 launcher. Finds a Python 3 and starts the game.
# Nothing to compile or install: the game is pure standard library.

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

PY=""
for CAND in python3 python3.13 python3.12 python3.11 python3.10 python3.9 python; do
    if command -v "$CAND" >/dev/null 2>&1 && \
       "$CAND" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' 2>/dev/null; then
        PY="$CAND"
        break
    fi
done

if [ -z "$PY" ]; then
    cat >&2 <<'EOF'
Module 5 needs Python 3.8 or newer, and couldn't find one.

  macOS  : already ships with python3 (if missing: xcode-select --install)
  Debian : sudo apt install python3
  Fedora : sudo dnf install python3
  Arch   : sudo pacman -S python
EOF
    exit 1
fi

# the .pyz (single file, built with build.sh) takes priority if present
if [ -f "$DIR/m5.pyz" ]; then
    exec "$PY" "$DIR/m5.pyz" "$@"
fi
exec env PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}" "$PY" -m m5 "$@"
